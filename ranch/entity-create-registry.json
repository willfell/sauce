{
  "schema_version": 1,
  "contributions": {
    "meetings": [
      {
        "blueprint": "meetings",
        "id": "meeting",
        "label": "New Meeting",
        "icon": "users-plus",
        "prompts": [
          {
            "key": "title",
            "label": "Meeting title",
            "type": "string",
            "required": true
          },
          {
            "key": "project",
            "label": "Project (optional)",
            "type": "select",
            "required": false,
            "options_source": "all_projects",
            "default": "(none)"
          }
        ],
        "destination": {
          "folder_prefix": "spice/meetings/notes",
          "filename_prefix": "{{prompts.title}}-",
          "folder_date_pattern": "YYYY/MM-MMMM",
          "filename_date_pattern": "YYYY-MM-DD",
          "filename_suffix": ""
        },
        "frontmatter_template": {
          "date": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
          "created_at": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
          "type": "meeting",
          "summary": "",
          "attendees": [],
          "project": "{{prompts.project}}",
          "people": [],
          "tags": [],
          "cssclasses": [
            "wide"
          ]
        },
        "inline_body": "```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", { class: \"SpaceNavButtons\" });\n```\n",
        "render_in": {
          "kind": "hub",
          "target_path": "ranch/templates/Meeting Hub.md"
        }
      }
    ],
    "scratch": [
      {
        "blueprint": "scratch",
        "id": "scratch",
        "label": "+ New Scratch",
        "icon": "pencil-plus",
        "prompts": [
          {
            "key": "title",
            "label": "Scratch title (optional)",
            "type": "string",
            "required": false
          }
        ],
        "destination": {
          "folder_prefix": "spice/scratch/{{current_file.frontmatter.day}}-routed",
          "filename_prefix": "Scratch-{{current_file.frontmatter.day}}-",
          "filename_date_pattern": "HH-mm",
          "filename_suffix": ""
        },
        "frontmatter_template": {
          "type": "scratch",
          "created_at": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
          "day": "{{current_file.frontmatter.day}}",
          "title": "{{prompts.title}}"
        },
        "inline_body": "```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", { class: \"SpaceNavButtons\" });\n```\n\n---\n\n```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", { class: \"ScratchLeafActions\" });\n```\n\n---\n"
      }
    ],
    "project": [
      {
        "blueprint": "project",
        "id": "project",
        "label": "New Project",
        "icon": "folder-plus",
        "prompts": [
          {
            "key": "name",
            "label": "Project name",
            "type": "string",
            "required": true
          },
          {
            "key": "slug",
            "type": "string",
            "derive": "slugify(prompts.name)"
          }
        ],
        "destination": {
          "folder_prefix": "spice/projects/{{prompts.slug}}",
          "filename_prefix": "{{prompts.name|sanitize-filename}}"
        },
        "frontmatter_template": {
          "type": "project",
          "created_at": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
          "description": "",
          "status": "idea",
          "status_changed_at": "{{now.YYYY-MM-DD}}",
          "workstreams": [],
          "teams": [],
          "products": [],
          "sections": [],
          "tags": []
        },
        "body_template": "ranch/templates/Template, Project.md",
        "extra_files": [
          {
            "filename_pattern": "Project Map.md",
            "body_template": "ranch/templates/Template, Project Map.md"
          },
          {
            "filename_pattern": "{{prompts.slug}}-board.md",
            "body_template": "ranch/templates/Template, Project Board.md"
          },
          {
            "subfolder": "docs",
            "filename_pattern": "Docs.md",
            "body_template": "ranch/templates/Template, Docs Hub.md"
          }
        ],
        "render_in": {
          "kind": "hub",
          "target_path": "spice/projects/Projects.md"
        }
      },
      {
        "blueprint": "project",
        "id": "doc-note",
        "label": "+ New Doc",
        "icon": "file-plus",
        "prompts": [
          {
            "key": "title",
            "label": "Doc title",
            "type": "string",
            "required": true,
            "validate": "safe-filename"
          },
          {
            "key": "section",
            "label": "Section",
            "type": "string",
            "required": true,
            "default": "Knowledge",
            "validate": "safe-filename"
          },
          {
            "key": "section_slug",
            "label": "(derived from section)",
            "type": "string",
            "derive": "slugify(prompts.section)"
          }
        ],
        "destination": {
          "folder_prefix": "spice/projects/{{current_file.frontmatter.project_slug}}/docs/{{prompts.section_slug}}",
          "filename_prefix": "{{prompts.title|sanitize-filename}}"
        },
        "frontmatter_template": {
          "type": "doc-note",
          "created_at": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
          "project": "[[{{current_file.frontmatter.project_name}}]]",
          "project_slug": "{{current_file.frontmatter.project_slug}}",
          "section": "{{prompts.section}}",
          "tags": [
            "doc-note"
          ]
        },
        "body_template": "ranch/templates/Template, Doc Note.md",
        "render_in": {
          "kind": "hub",
          "target_path": "ranch/templates/Template, Docs Hub.md"
        }
      }
    ],
    "people": [
      {
        "blueprint": "people",
        "id": "person",
        "label": "+ New Person",
        "icon": "user-plus",
        "prompts": [
          {
            "key": "name",
            "label": "Name",
            "type": "string",
            "required": true,
            "validate": "safe-filename"
          }
        ],
        "destination": {
          "folder_prefix": "spice/people",
          "filename_prefix": "{{prompts.name}}"
        },
        "frontmatter_template": {
          "type": "person",
          "created_at": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
          "company": "",
          "location": "",
          "title": "",
          "email": "",
          "website": "",
          "aliases": [],
          "phone": "",
          "tags": []
        },
        "inline_body": "```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", { class: \"PersonNavButtons\" });\n```\n\n# [[{{prompts.name}}]]\n\n## Notes\n-\n\n## Meetings\n```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", {\n  class: \"PeopleRendering\",\n  method: \"renderMentionList\",\n  args: [dv, { mode: \"mentioning_person\", personLink: dv.current().file.link, scopePath: \"spice/meetings\" }, { style: \"cards\", limit: 50 }]\n});\n```\n\n## Daily Mentions\n```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", {\n  class: \"PeopleRendering\",\n  method: \"renderMentionList\",\n  args: [dv, { mode: \"mentioning_person\", personLink: dv.current().file.link, scopePath: \"spice/daily\" }, { style: \"list\", limit: 30 }]\n});\n```\n\n## Mentions\n```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", {\n  class: \"BacklinkPanel\",\n  method: \"render\",\n  args: [{ entityType: \"person\" }]\n});\n```\n",
        "render_in": {
          "kind": "hub",
          "target_path": "spice/people/People.md"
        }
      }
    ]
  },
