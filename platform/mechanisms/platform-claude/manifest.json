{
  "name": "platform-claude",
  "version": "0.2.0",
  "kind": "mechanism",
  "skills_dir": ".claude/skills/platform",
  "description": "Lifecycle slash commands (/install, /upgrade, /bootstrap) for managing sauce from inside Claude Code. Owns claude-md-renderer.js (consumed by install.js step 6d). Always-on posture \u2014 subscribe in every consumer. v0.1.1 PATCH (v0.33.1): claude_md_row.row.path corrected from mechanism slug 'platform-claude' to canonical command body dest paths ('.claude/commands/<verb>.md') so /audit --claude-surface resolves to a real file and lands in `aligned` rather than `dead_path` severity bucket. v0.1.3 PATCH (v0.102.0): adds spice/resources/ to DIRECTORY_MAP_SEEDS \u2014 registers the vault-default-paths namespace introduced by applyVaultDefaultPaths in install.js.",
  "depends_on": [],
  "files": [],
  "claude_surface": [
    {
      "kind": "command",
      "source": "commands/install.md",
      "dest": ".claude/commands/install.md"
    },
    {
      "kind": "command",
      "source": "commands/upgrade.md",
      "dest": ".claude/commands/upgrade.md"
    },
    {
      "kind": "command",
      "source": "commands/bootstrap.md",
      "dest": ".claude/commands/bootstrap.md"
    },
    {
      "kind": "command",
      "source": "commands/card-intake.md",
      "dest": ".claude/commands/card-intake.md"
    },
    {
      "kind": "skill",
      "source": "skills/install/SKILL.md",
      "dest": "{{skills_dir}}/install/SKILL.md"
    },
    {
      "kind": "skill",
      "source": "skills/upgrade/SKILL.md",
      "dest": "{{skills_dir}}/upgrade/SKILL.md"
    },
    {
      "kind": "skill",
      "source": "skills/bootstrap/SKILL.md",
      "dest": "{{skills_dir}}/bootstrap/SKILL.md"
    },
    {
      "kind": "skill",
      "source": "skills/card-intake/SKILL.md",
      "dest": "{{skills_dir}}/card-intake/SKILL.md"
    },
    {
      "kind": "claude_md_row",
      "table": "resolvers",
      "row": {
        "topic": "Install",
        "path": ".claude/commands/install.md",
        "command": "/install"
      }
    },
    {
      "kind": "claude_md_row",
      "table": "resolvers",
      "row": {
        "topic": "Upgrade",
        "path": ".claude/commands/upgrade.md",
        "command": "/upgrade"
      }
    },
    {
      "kind": "claude_md_row",
      "table": "resolvers",
      "row": {
        "topic": "Bootstrap",
        "path": ".claude/commands/bootstrap.md",
        "command": "/bootstrap"
      }
    },
    {
      "kind": "claude_md_row",
      "table": "resolvers",
      "row": {
        "topic": "Card Intake",
        "path": ".claude/commands/card-intake.md",
        "command": "/card-intake"
      }
    },
    {
      "kind": "claude_md_row",
      "table": "skills-index",
      "row": {
        "command": "/card-intake",
        "skill_path": ".claude/skills/platform/card-intake/SKILL.md"
      }
    },
    {
      "kind": "command",
      "source": "commands/slice-plan.md",
      "dest": ".claude/commands/slice-plan.md"
    },
    {
      "kind": "skill",
      "source": "skills/slice-plan/SKILL.md",
      "dest": "{{skills_dir}}/slice-plan/SKILL.md"
    },
    {
      "kind": "claude_md_row",
      "table": "resolvers",
      "row": {
        "topic": "Slice Plan",
        "path": ".claude/commands/slice-plan.md",
        "command": "/slice-plan"
      }
    },
    {
      "kind": "claude_md_row",
      "table": "skills-index",
      "row": {
        "command": "/slice-plan",
        "skill_path": ".claude/skills/platform/slice-plan/SKILL.md"
      }
    }
  ],
  "post_install": [
    {
      "type": "notice",
      "message": "platform-claude@0.1.0 installed. Lifecycle slash commands /install /upgrade /bootstrap now available in Claude Code."
    }
  ]
}
