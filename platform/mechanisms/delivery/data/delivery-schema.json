{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sauce Delivery contract registry",
  "contract": {
    "name": "delivery",
    "version": "1.2.0",
    "minimum_compatible_version": "1.0.0",
    "description": "Registry half of Delivery. v1.2 adds the terminal discarded status (excluded from epic rollups) and the waiting rollup bucket for parked slices; v1.1 added explicit epic, slice, and ratification-receipt record kinds while preserving the v1.0 execution-card contract."
  },
  "enums": {
    "status": ["planning", "in_progress", "blocked", "parked", "completed", "discarded"],
    "model_profile": ["standard", "heavy"],
    "execution_mode": ["release", "docs_only"],
    "batch_policy": ["continue", "stop_after", "supervised_only"],
    "posture": ["claimable", "blocked_by_dependencies", "docs_only", "awaiting_user_decision", "done"],
    "epic_state": ["planned", "active", "blocked", "done"],
    "ratification_decision": ["accepted", "provisionally_accepted"],
    "failure_class": ["infra", "code", "mixed", "unknown"],
    "risk_dimension": ["new_mechanism", "schema", "migration", "consumer_subscription", "multi_blueprint_ui", "shared_contract", "control_plane"]
  },
  "status_aliases": {
    "planning": "planning",
    "in-planning": "planning",
    "in_progress": "in_progress",
    "in-progress": "in_progress",
    "blocked": "blocked",
    "parked": "parked",
    "completed": "completed",
    "discarded": "discarded"
  },
  "types": {
    "execution-card": {
      "description": "One bounded, independently releasable Delivery execution child.",
      "fields": [
        {
          "name": "card",
          "type": "string",
          "required": true,
          "since_version": "1.0.0",
          "description": "Canonical card identity supplied from the note filename or intake title.",
          "consumer_descriptions": {
            "planner": "Author one unique trimmed card title; filenames and frontmatter comparisons use this identity.",
            "coordinator": "Use the canonical normalized identity as the ledger key; never infer ownership from an identifier prefix."
          }
        },
        {
          "name": "schema_version",
          "type": "string",
          "required": true,
          "default": "1.2.0",
          "since_version": "1.0.0",
          "description": "Delivery contract version stamped at authoring time. Newer-than-engine versions fail closed."
        },
        {
          "name": "parent_card",
          "type": "string",
          "required": true,
          "since_version": "1.0.0",
          "description": "Explicit parent authority; wikilink, alias, and bare forms normalize to one identity.",
          "consumer_descriptions": {
            "planner": "Link the exact non-claimable parent card.",
            "coordinator": "Compare this normalized field for sibling ownership; identifier prefixes are never authority."
          }
        },
        {
          "name": "slice",
          "type": "string",
          "required": true,
          "since_version": "1.0.0",
          "description": "Short human navigation label within the explicit parent."
        },
        {
          "name": "model_profile",
          "type": "string",
          "required": true,
          "enum": "model_profile",
          "since_version": "1.0.0",
          "description": "Reasoning profile; independent from unattended safety policy."
        },
        {
          "name": "execution_mode",
          "type": "string",
          "required": true,
          "enum": "execution_mode",
          "default": "release",
          "since_version": "1.0.0",
          "description": "Release-backed code work or explicitly supervised docs-only validation."
        },
        {
          "name": "batch_policy",
          "type": "string",
          "required": true,
          "enum": "batch_policy",
          "default": "continue",
          "since_version": "1.0.0",
          "description": "Machine-readable continuation ceiling. Derived policy may strengthen but never weaken it."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "enum": "status",
          "default": "planning",
          "since_version": "1.0.0",
          "description": "Normalized projection vocabulary shared by cards, boards, and coordinator phases."
        },
        {
          "name": "touch_zones",
          "type": "array:zone",
          "required": true,
          "since_version": "1.0.0",
          "description": "Non-empty exclusive working set expressed as workspace-relative paths or {root,path} tuples.",
          "consumer_descriptions": {
            "planner": "Declare the smallest canonical path set covering every intended edit; use tuples only for multi-root work.",
            "coordinator": "Normalize path segments and reject equality or nesting conflicts within the same logical root."
          }
        },
        {
          "name": "depends_on",
          "type": "array:identity",
          "required": true,
          "default": [],
          "since_version": "1.0.0",
          "description": "Forward dependencies only. Reverse links are derived and Archive never proves completion."
        },
        {
          "name": "deploy_subscriptions",
          "type": "object:deployment-map",
          "required": true,
          "since_version": "1.0.0",
          "description": "Exact headspace, Accuris, and ERO component additions; empty arrays remain explicit. Note frontmatter may carry this semantic object directly (legacy) or as a JSON text scalar (canonical Obsidian-safe encoding)."
        },
        {
          "name": "epic",
          "type": "string",
          "required": true,
          "since_version": "1.0.0",
          "description": "Planning authority or design artifact that explains the execution child."
        },
        {
          "name": "evidence",
          "type": "array:evidence-claim",
          "required": true,
          "since_version": "1.0.0",
          "description": "Pinned evidence claims. Current claims require source identity, capture timestamp, revision or external identifier, locator, and supported claim; historical strings remain readable only with an unpinned-evidence warning. Note frontmatter may carry this semantic array directly (legacy) or as a JSON text scalar (canonical Obsidian-safe encoding)."
        },
        {
          "name": "context_pack",
          "type": "string",
          "required": false,
          "since_version": "1.0.0",
          "description": "Optional versioned context-pack link; absence is backward-safe."
        },
        {
          "name": "release_required",
          "type": "boolean",
          "required": false,
          "since_version": "1.0.0",
          "description": "Derived true for release mode and false for docs_only; conflicting authored values are invalid."
        },
        {
          "name": "deployment_required",
          "type": "boolean",
          "required": false,
          "since_version": "1.0.0",
          "description": "Derived true for release mode and false for docs_only; completion proof follows the derived value."
        },
        {
          "name": "risk_dimensions",
          "type": "array:risk-dimension",
          "required": false,
          "default": [],
          "since_version": "1.0.0",
          "description": "Explicit high-risk dimensions. Any listed dimension requires the heavy model profile."
        }
      ]
    },
    "epic": {
      "description": "A non-claimable planning atlas whose lifecycle and posture are derived from slice records.",
      "fields": [
        { "name": "type", "type": "string", "required": true, "since_version": "1.1.0", "description": "Literal epic record discriminator." },
        { "name": "schema_version", "type": "string", "required": true, "since_version": "1.1.0", "description": "Delivery registry version." },
        { "name": "source_board", "type": "string", "required": true, "since_version": "1.1.0", "description": "Workspace-relative parent board path." },
        { "name": "kanban_board", "type": "string", "required": true, "since_version": "1.1.0", "description": "Same workspace-relative parent board path." },
        { "name": "status", "type": "string", "required": true, "enum": "epic_state", "since_version": "1.1.0", "description": "Coordinator-painted derived lifecycle projection." },
        { "name": "epic_board", "type": "string", "required": true, "since_version": "1.1.0", "description": "Workspace-relative board_role: epic board path." },
        { "name": "posture", "type": "string", "required": true, "enum": "posture", "since_version": "1.1.0", "description": "Coordinator-painted derived posture projection." }
      ]
    },
    "slice": {
      "description": "An epic-owned execution record. The full execution-card field set remains authoritative and unchanged.",
      "fields": [
        { "name": "type", "type": "string", "required": true, "since_version": "1.1.0", "description": "Literal slice record discriminator." },
        { "name": "task_parent", "type": "string", "required": true, "since_version": "1.1.0", "description": "Workspace-relative epic atlas path resolving to the same identity as epic." },
        { "name": "source_board", "type": "string", "required": true, "since_version": "1.1.0", "description": "Workspace-relative sibling epic-board path." },
        { "name": "kanban_board", "type": "string", "required": true, "since_version": "1.1.0", "description": "Same workspace-relative sibling epic-board path." }
      ]
    },
    "ratification-receipt": {
      "description": "Machine-consumable authority receipt extracted only from one exact accepted Markdown section.",
      "fields": [
        { "name": "schema_version", "type": "string", "required": true, "since_version": "1.1.0", "description": "Delivery registry version." },
        { "name": "receipt_id", "type": "string", "required": true, "since_version": "1.1.0", "description": "Durable ratification identity." },
        { "name": "decision", "type": "string", "required": true, "enum": "ratification_decision", "since_version": "1.1.0", "description": "Accepted authority class." },
        { "name": "accepted_at", "type": "string", "required": true, "since_version": "1.1.0", "description": "ISO-8601 timestamp with timezone." },
        { "name": "authority", "type": "string", "required": true, "since_version": "1.1.0", "description": "Human or policy authority granting the decision." },
        { "name": "target_card", "type": "string", "required": true, "since_version": "1.1.0", "description": "Exact full canonical target-card identity from the selected section only." },
        { "name": "target_head", "type": "string", "required": true, "since_version": "1.1.0", "description": "Exact lowercase 40-hex parked HEAD token." },
        { "name": "scope", "type": "array:string", "required": true, "since_version": "1.1.0", "description": "Explicit bounded authority granted by the decision." },
        { "name": "artifact_path", "type": "string", "required": true, "since_version": "1.1.0", "description": "Workspace-relative Markdown artifact path." },
        { "name": "artifact_sha256", "type": "string", "required": true, "since_version": "1.1.0", "description": "Whole-artifact digest for drift detection." },
        { "name": "section_heading", "type": "string", "required": true, "since_version": "1.1.0", "description": "Exact uniquely selected Markdown heading." },
        { "name": "section_sha256", "type": "string", "required": true, "since_version": "1.1.0", "description": "Selected-section digest for authority binding." }
      ]
    },
    "evidence-claim": {
      "description": "A pinned snapshot supporting one claim about mutable state.",
      "fields": [
        { "name": "source_identity", "type": "string", "required": true, "since_version": "1.0.0", "description": "Stable identity of the repository, service, vault, or authority observed." },
        { "name": "captured_at", "type": "string", "required": true, "since_version": "1.0.0", "description": "ISO-8601 timestamp with timezone recording when the source was observed." },
        { "name": "revision", "type": "string", "required": true, "since_version": "1.0.0", "description": "Commit, hash, receipt ID, PR/tag, or external revision pin." },
        { "name": "locator", "type": "string", "required": true, "since_version": "1.0.0", "description": "Path/line, symbol, heading, URL, or other source locator." },
        { "name": "claim", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact claim the pinned snapshot supports." }
      ]
    },
    "release-ancestry-receipt": {
      "description": "Pinned deterministic proof that a feature PR merge is contained by the recorded release and tag.",
      "fields": [
        { "name": "ok", "type": "boolean", "required": true, "since_version": "1.0.0", "description": "True only after the deterministic ancestry adapter verifies containment." },
        { "name": "receipt_id", "type": "string", "required": true, "since_version": "1.0.0", "description": "Durable identifier for this ancestry check." },
        { "name": "repository", "type": "string", "required": true, "since_version": "1.0.0", "description": "Repository identity against which ancestry was checked." },
        { "name": "checked_at", "type": "string", "required": true, "since_version": "1.0.0", "description": "ISO-8601 timestamp with timezone for the ancestry observation." },
        { "name": "verifier_revision", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact deterministic engine revision that produced the receipt." },
        { "name": "feature_pr", "type": "integer:positive", "required": true, "since_version": "1.0.0", "description": "Feature PR identity tied to feature_merge_sha." },
        { "name": "feature_merge_sha", "type": "string", "required": true, "since_version": "1.0.0", "description": "Verified feature merge commit." },
        { "name": "release_pr", "type": "integer:positive", "required": true, "since_version": "1.0.0", "description": "Containing release PR identity." },
        { "name": "release_merge_sha", "type": "string", "required": true, "since_version": "1.0.0", "description": "Verified containing release merge commit." },
        { "name": "tag", "type": "string", "required": true, "since_version": "1.0.0", "description": "Release tag verified against the containing release." }
      ]
    },
    "docs-validation-receipt": {
      "description": "Pinned exact-head/base proof for supervised docs-only completion.",
      "fields": [
        { "name": "ok", "type": "boolean", "required": true, "since_version": "1.0.0", "description": "True only when the documented validation passed." },
        { "name": "receipt_id", "type": "string", "required": true, "since_version": "1.0.0", "description": "Durable validation receipt identity." },
        { "name": "checked_at", "type": "string", "required": true, "since_version": "1.0.0", "description": "ISO-8601 validation timestamp with timezone." },
        { "name": "verifier_revision", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact verifier revision." },
        { "name": "head_sha", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact validated head commit." },
        { "name": "base_sha", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact validated base commit." }
      ]
    },
    "brew-promotion-receipt": {
      "description": "Pinned proof that the recorded tap PR produced the installed Homebrew version.",
      "fields": [
        { "name": "ok", "type": "boolean", "required": true, "since_version": "1.0.0", "description": "True only after deterministic Homebrew verification." },
        { "name": "receipt_id", "type": "string", "required": true, "since_version": "1.0.0", "description": "Durable promotion receipt identity." },
        { "name": "checked_at", "type": "string", "required": true, "since_version": "1.0.0", "description": "ISO-8601 promotion observation timestamp with timezone." },
        { "name": "verifier_revision", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact deterministic verifier revision." },
        { "name": "tap_pr", "type": "integer:positive", "required": true, "since_version": "1.0.0", "description": "Tap PR that promoted the formula." },
        { "name": "installed_version", "type": "string", "required": true, "since_version": "1.0.0", "description": "Verified Homebrew installation version." }
      ]
    },
    "vault-deployment-receipt": {
      "description": "Vault-specific install and drift-verification proof.",
      "fields": [
        { "name": "vault", "type": "string", "required": true, "since_version": "1.0.0", "description": "Exact required vault identity." },
        { "name": "path", "type": "string", "required": true, "since_version": "1.0.0", "description": "Verified vault locator." },
        { "name": "ok", "type": "boolean", "required": true, "since_version": "1.0.0", "description": "True only after install and status checks pass." },
        { "name": "required_version", "type": "string", "required": true, "since_version": "1.0.0", "description": "Release floor applied to this vault." },
        { "name": "installed_version", "type": "string", "required": true, "since_version": "1.0.0", "description": "Verified installed Sauce version." },
        { "name": "started_at", "type": "string", "required": true, "since_version": "1.0.0", "description": "ISO-8601 deployment start timestamp with timezone." },
        { "name": "finished_at", "type": "string", "required": true, "since_version": "1.0.0", "description": "ISO-8601 deployment completion timestamp with timezone; must not precede started_at." },
        { "name": "status_exit", "type": "integer:nonnegative", "required": true, "since_version": "1.0.0", "description": "Read-only post-install status exit code; completion requires zero." },
        { "name": "history_errors", "type": "array:string", "required": true, "since_version": "1.0.0", "description": "Install-history errors; completion requires an empty array." },
        { "name": "added_subscriptions", "type": "array:string", "required": true, "since_version": "1.0.0", "description": "Subscriptions newly inserted by this deployment attempt; may be empty on retry." },
        { "name": "verified_subscriptions", "type": "array:string", "required": true, "since_version": "1.0.0", "description": "Current post-install subscription snapshot used for retry-safe requested-component proof." }
      ]
    }
  },
  "policies": {
    "required_vaults": ["headspace", "accuris", "ero"],
    "workspace_roots": ["workshop", "headspace", "accuris", "ero"],
    "exclusive_zones": ["platform/install.js", "package.json", ".github/workflows", "platform/manifest.json", "shared-registries", "homebrew-promotion"],
    "control_plane_zone_prefixes": ["scripts/autoloop", "scripts/release", ".agents/skills/card-intake", "platform/mechanisms/delivery", ".github/workflows"],
    "high_risk_zone_prefixes": ["platform/mechanisms", "platform/install.js", "scripts/autoloop", "scripts/release", ".github/workflows"],
    "policy_strength": ["continue", "stop_after", "supervised_only"],
    "epic_forbidden_execution_fields": ["touch_zones", "model_profile", "batch_policy", "acceptance_tests", "deploy_subscriptions", "execution_mode", "release_required", "deployment_required"],
    "slice_scope_caps": { "touch_zones": 6, "acceptance_tests": 12, "risk_dimensions": 3, "carried_findings": 12 }
  },
  "changelog": [
    {
      "version": "1.0.0",
      "changes": [
        { "field": "schema_version", "migration": { "type": "default_backfill", "value": "1.0.0" } },
        { "field": "execution_mode", "migration": { "type": "default_backfill", "value": "release" } },
        { "field": "depends_on", "migration": { "type": "default_backfill", "value": [] } },
        { "field": "deploy_subscriptions", "migration": { "type": "default_backfill", "value": { "headspace": [], "accuris": [], "ero": [] } } },
        { "field": "evidence", "migration": { "type": "manual", "reason": "Mutable evidence cannot be pinned without source identity, capture time, revision, locator, and claim." } },
        { "field": "batch_policy", "migration": { "type": "derive_from", "expression": "derivePolicy(card)" } },
        { "field": "release_required", "migration": { "type": "derive_from", "expression": "execution_mode === 'release'" } },
        { "field": "deployment_required", "migration": { "type": "derive_from", "expression": "execution_mode === 'release'" } }
      ]
    },
    {
      "version": "1.1.0",
      "changes": [
        { "record_kind": "epic", "migration": { "type": "create_only", "reason": "Legacy task hubs are never retyped by a heal." } },
        { "record_kind": "slice", "migration": { "type": "create_only", "reason": "Legacy execution cards remain valid v1.0 records until explicit intake migration." } },
        { "record_kind": "ratification-receipt", "migration": { "type": "create_only", "reason": "Prose authority is never inferred; a selected section must carry an explicit receipt block." } }
      ]
    },
    {
      "version": "1.2.0",
      "changes": [
        { "field": "status", "migration": { "type": "enum_extension", "reason": "BGR redesign 2026-07-25: discarded is a new terminal status for permanently removed work. Rollups exclude discarded slices entirely, and parked slices count in a new waiting bucket that rolls up like blocked instead of active." } }
      ]
    }
  ],
