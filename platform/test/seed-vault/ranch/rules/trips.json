{
  "contributions": {
    "trips": [
      {
        "scope": {
          "path_glob": "spice/trips/*/Trip Atlas.md"
        },
        "extends": "_canonical-vocab",
        "required_frontmatter": {
          "type": {
            "required": true,
            "type": "string",
            "equals": "trip"
          },
          "start_date": {
            "required": true,
            "type": "string",
            "matches": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
          },
          "end_date": {
            "required": true,
            "type": "string",
            "matches": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
          },
          "location": {
            "required": true,
            "type": "string"
          }
        }
      },
      {
        "scope": {
          "path_glob": "spice/trips/Trips.md"
        },
        "extends": "_canonical-vocab",
        "required_frontmatter": {
          "cssclasses": {
            "required": true,
            "type": "list",
            "contains": [
              "wide"
            ]
          }
        }
      }
    ]
  }
}