{
  "name": "sticky-notes",
  "version": "0.11.0",
  "kind": "blueprint",
  "module_directory": "sticky-notes",
  "skills_dir": ".claude/skills/sticky-notes",
  "description": "Low-friction quick-capture sticky notes. Global hub at spice/sticky-notes/Sticky.md, per-day day-hubs (Sticky-Day-YYYY-MM-DD.md) under YYYY/MM-MMMM/YYYY-MM-DD/ sub-folders, and timestamped leaf notes named Sticky-YYYY-MM-DD-HH-mm-ss.md (per-second suffix so multiple captures within one minute never collide). v0.9.0 renames the blueprint wholesale from its previous quick-capture incarnation (types sticky-note / sticky-day / sticky-hub, StickyChromeBar-only surfaces — the three legacy per-surface action helpers are dropped) and lands the click-to-rename title banner on leaf notes plus the searchable Days|All hub view in the same version. An install migration converts existing consumer vaults to the new folder, filenames, and types.",
  "depends_on": [
    {
      "name": "nav-buttons",
      "range": ">=2.6.1"
    },
    {
      "name": "customjs-guard",
      "range": ">=1.0.0"
    },
    {
      "name": "cards",
      "range": ">=0.2.4"
    },
    {
      "name": "accent-button",
      "range": ">=0.1.0"
    },
    {
      "name": "entity-create",
      "range": ">=0.4.0"
    },
    {
      "name": "platform-claude",
      "range": ">=0.1.1"
    },
    {
      "name": "breadcrumb",
      "range": ">=0.1.0"
    },
    {
      "name": "section-explorer",
      "range": ">=0.5.4"
    },
    {
      "name": "render-safe",
      "range": ">=0.1.0"
    },
    {
      "name": "chrome-bar",
      "range": ">=0.3.0"
    },
    {
      "name": "doc-search",
      "range": ">=0.1.0"
    }
  ],
  "breadcrumb": {
    "types": {
      "sticky-note": {
        "ancestors": [
          {
            "label": "lit:Sticky Notes"
          },
          {
            "label": "path:3"
          },
          {
            "label": "path:4",
            "link": "spice/sticky-notes/{path:2}/{path:3}/{path:4}/Sticky-Day-{path:4}.md"
          }
        ],
        "current": {
          "label": "fm:time|file:basename"
        }
      },
      "sticky-day": {
        "ancestors": [
          {
            "label": "lit:Sticky Notes"
          },
          {
            "label": "path:3"
          }
        ],
        "current": {
          "label": "path:4"
        }
      }
    }
  },
  "customjs_classes": [
    "StickyHubCards",
    "StickyDayList",
    "StickyChromeBar",
    "StickyDayMigrate",
    "StickyDayMigrateInit"
  ],
  "customjs_startup_scripts": [
    "StickyDayMigrateInit"
  ],
  "files": [
    {
      "source": "templates/Sticky Note.md",
      "dest": "{{templates_path}}/Sticky Note.md"
    },
    {
      "source": "templates/Sticky Day Hub.md",
      "dest": "{{templates_path}}/Sticky Day Hub.md"
    },
    {
      "source": "templates/Sticky Hub.md",
      "dest": "{{module_directory}}/Sticky.md"
    },
    {
      "source": "helpers/sticky-hub-cards.js",
      "dest": "{{scripts_path}}/sticky-notes/sticky-hub-cards.js"
    },
    {
      "source": "helpers/sticky-day-list.js",
      "dest": "{{scripts_path}}/sticky-notes/sticky-day-list.js"
    },
    {
      "source": "helpers/sticky-chrome-bar.js",
      "dest": "{{scripts_path}}/sticky-notes/sticky-chrome-bar.js"
    },
    {
      "source": "helpers/sticky-day-migrate.js",
      "dest": "{{scripts_path}}/sticky-notes/sticky-day-migrate.js"
    },
    {
      "source": "helpers/sticky-day-migrate-init.js",
      "dest": "{{scripts_path}}/sticky-notes/sticky-day-migrate-init.js"
    }
  ],
  "claude_surface": [
    {
      "kind": "command",
      "source": "commands/sticky-notes.md",
      "dest": ".claude/commands/sticky-notes.md"
    },
    {
      "kind": "skill",
      "source": "skills/new-sticky-note/SKILL.md",
      "dest": "{{skills_dir}}/new-sticky-note/SKILL.md"
    },
    {
      "kind": "claude_md_row",
      "table": "resolvers",
      "row": {
        "topic": "Sticky Notes",
        "path": "{{module_directory}}",
        "command": "/sticky-notes"
      }
    }
  ],
  "nav_buttons": [
    {
      "id": "sticky-day-hub",
      "label": "Sticky Notes",
      "icon": "sticky-note",
      "order": 130,
      "action": {
        "type": "runTemplaterTemplate",
        "template_source": "Sticky Day Hub.md",
        "folder_prefix": "{{module_directory}}",
        "folder_date_pattern": "YYYY/MM-MMMM/YYYY-MM-DD",
        "filename_prefix": "Sticky-Day-",
        "filename_date_pattern": "YYYY-MM-DD",
        "filename_suffix": ""
      }
    }
  ],
  "new_entity_buttons": [
    {
      "id": "sticky-note",
      "label": "+ New Sticky Note",
      "icon": "pencil-plus",
      "prompts": [
        {
          "key": "title",
          "label": "Sticky note title (optional)",
          "type": "string",
          "required": false
        }
      ],
      "destination": {
        "folder_prefix": "spice/sticky-notes/{{current_file.frontmatter.day|today}}-routed",
        "filename_prefix": "Sticky-{{current_file.frontmatter.day|today}}-",
        "filename_date_pattern": "HH-mm-ss",
        "filename_suffix": ""
      },
      "frontmatter_template": {
        "type": "sticky-note",
        "created_at": "{{now.YYYY-MM-DDTHH:mm:ssZ}}",
        "day": "{{current_file.frontmatter.day|today}}",
        "title": "{{prompts.title}}"
      },
      "inline_body": "```dataviewjs\nawait dv.view(\"ranch/views/customjs-guard\", { class: \"StickyChromeBar\" });\n```\n"
    }
  ],
  "templater_folder_templates": [
    {
      "folder": "{{module_directory}}",
      "template": "{{templates_path}}/Sticky Note.md"
    }
  ],
  "rule_fragments": [
    {
      "target": "sticky-note",
      "fragment": {
        "scope": {
          "path_glob": "spice/sticky-notes/**/Sticky-2*.md"
        },
        "extends": "_canonical-vocab",
        "required_frontmatter": {
          "type": {
            "required": true,
            "equals": "sticky-note"
          },
          "day": {
            "required": true,
            "type": "string"
          }
        },
        "naming_pattern": "^Sticky-\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}(-\\d{2})?\\.md$"
      }
    },
    {
      "target": "sticky-day-hub",
      "fragment": {
        "scope": {
          "path_glob": "spice/sticky-notes/**/Sticky-Day-*.md"
        },
        "extends": "_canonical-vocab",
        "required_frontmatter": {
          "type": {
            "required": true,
            "equals": "sticky-day"
          },
          "day": {
            "required": true,
            "type": "string"
          }
        },
        "naming_pattern": "^Sticky-Day-\\d{4}-\\d{2}-\\d{2}\\.md$"
      }
    }
  ]
}
