{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cowork eod-review atomic-note sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "generated_at",
    "cadence",
    "engagement_id",
    "frontmatter",
    "surfaced_kinds",
    "surfaced_items",
    "render_aspects_applied",
    "memory_used",
    "plan_dispatch"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0", "1.2.0"] },
    "generated_by": { "type": "string", "pattern": "^cowork:[a-z-]+@\\d+\\.\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "cadence": { "const": "eod-review" },
    "engagement_id": { "type": "string", "minLength": 1 },
    "frontmatter": {
      "type": "object",
      "required": ["type", "engagement_id", "day", "title", "summary", "created_at"],
      "properties": {
        "type": { "const": "cowork-eod-review" },
        "engagement_id": { "type": "string" },
        "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "generator": { "type": "string" },
        "prompt_source": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string" },
        "warning": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "surfaced_kinds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "surfaced_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "kind", "callout_type", "title", "features"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "callout_type": { "type": "string", "enum": ["example", "warning", "info", "tip", "todo", "question", "quote"] },
          "title": { "type": "string" },
          "features": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "render_aspects_applied": {
      "type": "array",
      "items": { "type": "string" }
    },
    "memory_used": {
      "type": "object",
      "required": ["yesterday_present", "drift_warning_present", "echoes_count"],
      "properties": {
        "yesterday_present": { "type": "boolean" },
        "drift_warning_present": { "type": "boolean" },
        "echoes_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "plan_dispatch": {
      "type": "object",
      "required": ["mode", "kinds_dispatched", "warnings_emitted"],
      "properties": {
        "mode": { "type": "string", "enum": ["prefs", "legacy", "legacy-classifier-fallback"] },
        "kinds_dispatched": { "type": "integer", "minimum": 0 },
        "warnings_emitted": { "type": "integer", "minimum": 0 },
        "classifier_cache_hit": { "type": "boolean" },
        "pending_confirmations_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage_gap": {
      "type": "object",
      "description": "v0.97.4 — coverage-gap write-guard output. expected = engagement priority list passed by orchestrator; surfaced = kinds that actually produced data; skipped = expected \\ surfaced (preserving expected order). reconcile-cowork reads this for cross-day coverage monitoring.",
      "required": ["expected", "surfaced", "skipped"],
      "properties": {
        "expected": { "type": "array", "items": { "type": "string" } },
        "surfaced": { "type": "array", "items": { "type": "string" } },
        "skipped":  { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "feedback_capture": {
      "type": "object",
      "description": "v0.98.1 capture observability + v0.98.2 identity registry. 1.1.0 sidecars carry counts only; 1.2.0 adds items[] + ambiguous_items[] and sentinel v=2.",
      "additionalProperties": false,
      "properties": {
        "sentinel_version": { "type": "string", "enum": ["v=1", "v=2"] },
        "item_count": { "type": "integer", "minimum": 0 },
        "kinds_with_knobs": { "type": "array", "items": { "type": "string" } },
        "ambiguous_knobs": { "type": "array", "items": { "type": "string" } },
        "ambiguous_items": { "type": "array", "items": { "type": "string" } },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "kind", "identifier", "label"],
            "properties": {
              "item_id": { "type": "string", "pattern": "^item-[a-z]+-[0-9a-f]{7}$" },
              "kind": { "type": "string", "minLength": 1 },
              "identifier": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "required": ["sentinel_version", "item_count"]
    }
  }
}
