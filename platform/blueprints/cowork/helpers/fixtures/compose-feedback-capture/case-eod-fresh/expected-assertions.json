{
  "case_name": "case-eod-fresh",
  "description": "First-fire on a day with 2 chat items + 1 github item; no prior_md",
  "asserts": [
    { "type": "rail_md_regex", "pattern": "> \\[!todo\\]\\+ Was today useful\\?" },
    { "type": "rail_md_regex", "pattern": "<!-- cowork:feedback-capture v=1 -->" },
    { "type": "rail_md_regex", "pattern": "> > \\[!summary\\]- Chat — items" },
    { "type": "rail_md_regex", "pattern": "> > \\[!summary\\]- GitHub — items" },
    { "type": "rail_md_regex", "pattern": "\\*\\*Fire chat:\\*\\* `\\[ \\] less` `\\[ \\] same` `\\[ \\] more`" },
    { "type": "rail_md_regex", "pattern": "\\*\\*Fire GitHub:\\*\\* `\\[ \\] less` `\\[ \\] same` `\\[ \\] more`" },
    { "type": "rail_md_regex", "pattern": "```feedback" },
    { "type": "sidecar_field", "path": "sentinel_version", "value": "v=1" },
    { "type": "sidecar_field", "path": "item_count", "value": 3 },
    { "type": "sidecar_field_array_contains", "path": "kinds_with_knobs", "value": "chat" },
    { "type": "sidecar_field_array_contains", "path": "kinds_with_knobs", "value": "github" },
    { "type": "sidecar_field_array_length", "path": "ambiguous_knobs", "value": 0 }
  ]
}
