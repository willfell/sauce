{
  "case_name": "case-eod-ambiguous-knob",
  "description": "Prior has multiple [x] on chat knob row (user transitioning); preserve UI state + flag sidecar",
  "asserts": [
    { "type": "rail_md_regex", "pattern": "<!-- cowork:feedback-capture v=3 -->" },
    { "type": "rail_md_regex", "pattern": "> Useful: `\\[ \\] yes` `\\[ \\] no`" },
    { "type": "rail_md_regex", "pattern": "\\*\\*Fire chat:\\*\\* `\\[x\\] less` `\\[ \\] same` `\\[x\\] more`" },
    { "type": "rail_md_regex", "pattern": "> > Mattered:" },
    { "type": "rail_md_regex", "pattern": "> > Didn't like:" },
    { "type": "sidecar_field", "path": "sentinel_version", "value": "v=3" },
    { "type": "sidecar_field_array_contains", "path": "ambiguous_knobs", "value": "chat" },
    { "type": "sidecar_field_array_length", "path": "items", "value": 1 }
  ]
}
