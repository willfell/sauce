    { "type": "rail_md_regex", "pattern": "> Useful: `\\[ \\] yes` `\\[ \\] no`" },
    { "type": "rail_md_regex", "pattern": "> > - \\[x\\] \\[\\[#\\^item-chat-[0-9a-f]{7}\\|Zhenzhen PR #353 thread\\]\\]" },
    { "type": "rail_md_regex", "pattern": "\\*\\*Fire chat:\\*\\* `\\[ \\] less` `\\[ \\] same` `\\[x\\] more`" },
    { "type": "rail_md_regex", "pattern": "Diana's emails are noise\\." },
    { "type": "rail_md_regex", "pattern": "> > Mattered:" },
    { "type": "rail_md_regex", "pattern": "> > Didn't like:" },
