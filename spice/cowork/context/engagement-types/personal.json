{
  "id": "personal",
  "version": "0.5.0",
  "schema_version": 1,
  "label": "Personal life",
  "consumes": ["to-do", "daily", "people", "journal"],
  "required_fields": [
    { "id": "owner_name", "type": "string", "prompt": "Your name" },
    { "id": "home_city",  "type": "string", "prompt": "City (used by gather-weather)" }
  ],
  "optional_fields": [
    { "id": "inner_circle_people",        "type": "string[]", "prompt": "Inner-circle people for iMessage filtering (comma-separated names)" },
    { "id": "includes_wellness_prompts",  "type": "boolean",  "prompt": "Include wellness prompts in EOD review? (true/false)", "default_value": true }
  ],
  "supported_cadences": ["morning", "midday", "eod", "weekly", "monthly", "tick", "synthesize_day", "synthesize_week", "lens_shift"],
  "default_cadences": {
    "morning": true,
    "midday":  false,
    "eod":     true,
    "weekly":  true,
    "monthly": true,
    "tick": true,
    "synthesize_day": true,
    "synthesize_week": true
  },
  "render_aspects": {
    "ai_committee":           "skip",
    "kanban_projects":        "include",
    "inner_circle_imessage":  "include",
    "new_mcp_notice":         "include",
    "semantic_related":       "include",
    "anti_echo":              "skip"
  },
  "tripwire_aspects": []
}
